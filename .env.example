# Copy to .env for local dev (loaded by `deno task dev` via --env-file).
# `deno task start` reads these from the real environment instead.

# Absolute or relative path to the markdown vault. Must already exist at boot.
NOTES_DIR=./vault

# Port for Deno.serve.
PORT=8000

# Single shared token checked on every API request (see spec.md §11).
AUTH_TOKEN=dev-token-change-me

# Path to the design-token YAML (see spec.md §12 / src/theme.ts). Optional —
# a missing file just means the built-in Material 3 Expressive default
# applies. If you point this somewhere other than the default, also update
# the --allow-read list in the `start` task in deno.json.
THEME_PATH=./theme.yaml
