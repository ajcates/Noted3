{
  "tasks": {
    "dev": "deno run --watch --env-file --allow-read --allow-write --allow-net --allow-env main.ts",
    "start": "deno run --allow-read=$NOTES_DIR,./public --allow-write=$NOTES_DIR --allow-net --allow-env main.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env --allow-run --allow-sys",
    "test:api": "deno test --allow-read --allow-write --allow-net --allow-env tests/e2e/notes-crud.test.ts",
    "check": "deno check main.ts public/app/main.js"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "checkJs": true,
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "fmt": {
    "exclude": ["notes/"]
  },
  "lint": {
    "exclude": ["notes/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/yaml": "jsr:@std/yaml@^1.0.9",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/http": "jsr:@std/http@^1.0.13",
    "markdown-it": "npm:markdown-it@14.1.0",
    "@types/markdown-it": "npm:@types/markdown-it@14.1.2",
    "playwright": "npm:playwright@1.63.0"
  },
  "lock": true
}
