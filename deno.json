{
  "tasks": {
    "dev": "deno run --watch --env-file --allow-read --allow-write --allow-net --allow-env --allow-run main.ts",
    "start": "deno run --allow-read=$NOTES_DIR,./public,$HOME/.noted --allow-write=$NOTES_DIR,$HOME/.noted --allow-net --allow-env --allow-run main.ts",
    "test": "deno test -A",
    "test:api": "deno test --allow-read --allow-write --allow-net --allow-env tests/e2e/notes-crud.test.ts",
    "check": "deno check main.ts public/app/main.js",
    "check:contrast": "deno run scripts/check-contrast.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "checkJs": true,
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "fmt": {
    "exclude": ["notes/", "public/vendor/"]
  },
  "lint": {
    "exclude": ["notes/", "public/vendor/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/yaml": "jsr:@std/yaml@^1.0.9",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/http": "jsr:@std/http@^1.0.13",
    "markdown-it": "npm:markdown-it@14.1.0",
    "@types/markdown-it": "npm:@types/markdown-it@14.1.2",
    "playwright": "npm:playwright@1.63.0",

    "@codemirror/state": "npm:@codemirror/state@^6.5.2",
    "@codemirror/view": "npm:@codemirror/view@^6.36.0",
    "@codemirror/language": "npm:@codemirror/language@^6.11.0",
    "@codemirror/commands": "npm:@codemirror/commands@^6.8.0",
    "@codemirror/autocomplete": "npm:@codemirror/autocomplete@^6.18.0",
    "@codemirror/lang-markdown": "npm:@codemirror/lang-markdown@^6.3.0",
    "@lezer/highlight": "npm:@lezer/highlight@^1.2.0"
  },
  "lock": true,
  "nodeModulesDir": "none"
}
